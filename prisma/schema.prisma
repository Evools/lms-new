generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum MaterialType {
  LECTURE
  PRACTICE
  LAB
  VIDEO
  PDF
  DOCUMENT
  LINK
  TEST
}

enum AnnouncementScope {
  ALL
  GROUP
  TEACHERS
}

enum SubmissionStatus {
  SUBMITTED
  NEED_REVISION
  ACCEPTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  phone     String?
  role      Role     @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Group roles
  curatedGroups      Group[]        @relation("GroupCurator")
  monitoredGroups    Group[]        @relation("GroupMonitor")
  deputyGroups       Group[]        @relation("GroupDeputyMonitor")
  studentEnrollments GroupStudent[]

  // Teaching
  teacherGroupSubjects GroupSubject[] @relation("TeacherGroupSubjects")

  // Content created
  createdMaterials     Material[]
  createdAssignments   Assignment[]
  createdDocuments     Document[]
  createdAnnouncements Announcement[]
  createdTests         Test[]

  // Student submissions and activity
  submissions     AssignmentSubmission[]
  attendances     Attendance[]
  dutySchedules   DutySchedule[]
  testSubmissions TestSubmission[]
  notifications   Notification[]

  @@map("users")
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "2025-2026"
  isCurrent Boolean  @default(false)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups Group[]

  @@map("academic_years")
}

model Group {
  id              String   @id @default(cuid())
  name            String   @unique // e.g., "ИС-1-25"
  academicYearId  String
  curatorId       String?
  monitorId       String?
  deputyMonitorId String?
  isDutyEnabled   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  curator       User?        @relation("GroupCurator", fields: [curatorId], references: [id], onDelete: SetNull)
  monitor       User?        @relation("GroupMonitor", fields: [monitorId], references: [id], onDelete: SetNull)
  deputyMonitor User?        @relation("GroupDeputyMonitor", fields: [deputyMonitorId], references: [id], onDelete: SetNull)

  students      GroupStudent[]
  groupSubjects GroupSubject[]
  dutySchedules DutySchedule[]
  announcements Announcement[]

  @@map("groups")
}

model GroupStudent {
  groupId   String
  studentId String
  joinedAt  DateTime @default(now())

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([groupId, studentId])
  @@map("group_students")
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groupSubjects GroupSubject[]

  @@map("subjects")
}

model GroupSubject {
  id        String   @id @default(cuid())
  groupId   String
  subjectId String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher User    @relation("TeacherGroupSubjects", fields: [teacherId], references: [id], onDelete: Cascade)

  topics      Topic[]
  assignments Assignment[]
  attendances Attendance[]
  tests       Test[]

  @@unique([groupId, subjectId, teacherId])
  @@map("group_subjects")
}

model Topic {
  id             String   @id @default(cuid())
  groupSubjectId String
  title          String
  description    String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  groupSubject GroupSubject @relation(fields: [groupSubjectId], references: [id], onDelete: Cascade)

  materials   Material[]
  assignments Assignment[]
  tests       Test[]

  @@map("topics")
}

model Material {
  id        String       @id @default(cuid())
  topicId   String
  authorId  String
  type      MaterialType
  title     String
  content   String?
  fileUrl   String?
  linkUrl   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("materials")
}

model Assignment {
  id             String    @id @default(cuid())
  groupSubjectId String
  topicId        String?
  authorId       String
  title          String
  description    String
  fileUrl        String?
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  groupSubject GroupSubject @relation(fields: [groupSubjectId], references: [id], onDelete: Cascade)
  topic        Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id             String           @id @default(cuid())
  assignmentId   String
  studentId      String
  fileUrl        String?
  comment        String?
  teacherComment String?
  status         SubmissionStatus @default(SUBMITTED)
  submittedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  grade          Int?
  updatedAt      DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Attendance {
  id             String           @id @default(cuid())
  groupSubjectId String
  studentId      String
  date           DateTime
  status         AttendanceStatus @default(PRESENT)
  comment        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  groupSubject GroupSubject @relation(fields: [groupSubjectId], references: [id], onDelete: Cascade)
  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupSubjectId, studentId, date])
  @@map("attendances")
}

model DutySchedule {
  id        String   @id @default(cuid())
  groupId   String
  studentId String
  date      DateTime
  isLeader  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId, date])
  @@map("duty_schedules")
}

model Announcement {
  id            String            @id @default(cuid())
  authorId      String
  targetGroupId String?
  scope         AnnouncementScope @default(ALL)
  title         String
  content       String
  fileUrl       String?
  isPinned      Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  author      User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  targetGroup Group? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)

  @@map("announcements")
}

model Document {
  id          String   @id @default(cuid())
  authorId    String
  category    String // e.g. "методички", "положения", "инструкции", "шаблоны"
  title       String
  description String?
  fileUrl     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Test {
  id               String   @id @default(cuid())
  groupSubjectId   String
  topicId          String?
  authorId         String
  title            String
  description      String?
  timeLimit        Int? // minutes
  shuffleQuestions Boolean  @default(false)
  shuffleOptions   Boolean  @default(false)
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  groupSubject GroupSubject @relation(fields: [groupSubjectId], references: [id], onDelete: Cascade)
  topic        Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  questions   TestQuestion[]
  submissions TestSubmission[]

  @@map("tests")
}

model TestQuestion {
  id            String   @id @default(cuid())
  testId        String
  type          String   @default("SINGLE") // SINGLE, MULTIPLE, TEXT, TRUE_FALSE
  questionText  String
  options       String // JSON stringified array of option strings e.g. '["Option 1","Option 2"]'
  correctAnswer String // Exact correct answer option text or JSON array for MULTIPLE
  points        Int      @default(1)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@map("test_questions")
}

model TestSubmission {
  id          String   @id @default(cuid())
  testId      String
  studentId   String
  score       Int
  maxScore    Int
  answers     String // JSON stringified user answers map e.g. '{"q1":"Option A"}'
  submittedAt DateTime @default(now())

  test    Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId])
  @@map("test_submissions")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  type      String   @default("SYSTEM") // SYSTEM, TEST, ASSIGNMENT, ANNOUNCEMENT, GRADE
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
